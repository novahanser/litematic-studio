{
  "name": "litematic-studio",
  "version": "1.2.0",
  "description": "Offline Litematic 3D inspector with local Minecraft resources",
  "main": "src/main.cjs",
  "type": "module",
  "author": "Local Tools",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "npm run build && node tests/app-smoke.cjs",
    "test:edit": "npm run build && node tests/v2-edit-smoke.cjs",
    "test:renderer": "npm run build && node tests/v2-renderer-smoke.cjs",
    "test:portable": "node tests/portable-smoke.cjs",
    "dist": "npm run build && electron-builder --win portable --x64",
    "test:display": "npm run build && node tests/v3-display-smoke.cjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "three": "0.186.1"
  },
  "build": {
    "appId": "local.litematic.studio",
    "productName": "Litematic Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "src/core/**/*",
      "build/**/*",
      "resources/icon.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Litematic-Studio-${version}-win-x64.exe"
    }
  }
}
